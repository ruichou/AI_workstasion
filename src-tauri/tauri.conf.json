{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GlassWorkspace",
  "version": "0.1.0",
  "identifier": "com.glassworkspace.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Glass Workspace",
        "width": 1200,
        "height": 760,
        "minWidth": 490,
        "minHeight": 225,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": true,
        "shadow": true,
        "skipTaskbar": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http: https: data:; connect-src 'self' http: https: ws: ws://localhost:1420; font-src 'self' data:; media-src 'self' asset: http: https: data:",
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "resources": ["resources/config.json"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
